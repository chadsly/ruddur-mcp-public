{
  "name": "@ruddur/mcp-server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "ruddur-mcp": "dist/index.js",
    "ruddur-mcp-remote": "dist/remote.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "start:remote": "node dist/remote.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.3",
    "dotenv": "^16.5.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "qs": "6.16.0"
  }
}
