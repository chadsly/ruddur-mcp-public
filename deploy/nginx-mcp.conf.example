server {
    listen 443 ssl http2;
    server_name mcp.ruddur.com;

    ssl_certificate /etc/letsencrypt/live/mcp.ruddur.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp.ruddur.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Do not buffer Streamable HTTP/SSE responses.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        add_header X-Accel-Buffering no always;
    }
}

server {
    listen 80;
    server_name mcp.ruddur.com;
    return 301 https://$host$request_uri;
}
