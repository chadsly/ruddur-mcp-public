# Prefer an immutable commit tag or digest after the first successful rollout.
RUDDUR_MCP_IMAGE=registry.gitlab.com/ruddur1/ruddur-mcp/app:latest
RUDDUR_MCP_HOST_PORT=8080

# These three URL values must agree across MCP, backend, and OAuth discovery.
RUDDUR_MCP_PUBLIC_URL=https://mcp.ruddur.com/mcp
RUDDUR_MCP_RESOURCE=https://mcp.ruddur.com/mcp
RUDDUR_OAUTH_ISSUER=https://ruddur.com
OAUTH_ISSUER=https://ruddur.com

# Generate once and configure the identical value on backend and ruddur-mcp.
# Store the real value in your deployment secret manager, not in Git.
MCP_INTROSPECTION_SECRET=replace-with-at-least-32-random-bytes

OAUTH_CIMD_ALLOWED_HOSTS=chatgpt.com,claude.ai
RUDDUR_MCP_ALLOWED_ORIGINS=https://mcp.ruddur.com,https://ruddur.com,https://chatgpt.com,https://claude.ai
RUDDUR_MCP_TIMEOUT_MS=30000

# Frontend/backend public application URL used by login and OAuth consent.
APP_URL=https://ruddur.com
NEXT_PUBLIC_APP_URL=https://ruddur.com
NEXT_PUBLIC_API_URL=https://ruddur.com
