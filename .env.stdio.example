# Local stdio development only. Do not use this file for the hosted container.
RUDDUR_API_BASE=https://ruddur.com
RUDDUR_CREATOR_API_TOKEN=replace-with-a-scoped-creator-token

# Optional: filter tools shown to the local agent. The API remains authoritative.
RUDDUR_CREATOR_SCOPES=content.read,content.manage,media.read,media.manage,marketplace.read,marketplace.manage,marketplace.entitlements,analytics.read,events.write,billing.read

RUDDUR_MCP_ALLOW_MUTATIONS=true
RUDDUR_MCP_TIMEOUT_MS=30000
